# ==============================================================================
# Vibe Seekers - Complete Environment Configuration Template
# ==============================================================================

# Core App Secrets
SECRET_KEY=vibe-seekers-production-secret-key-change-me
FLASK_DEBUG=false

# Database Configuration
# Local SQLite default: sqlite:///vibe_seekers.db
# Render PostgreSQL (auto-provided via DATABASE_URL on Render):
DATABASE_URL=sqlite:///vibe_seekers.db

# Cloudinary Storage Configuration (Stores all product, banner, and logo images persistently)
# Get from your Cloudinary Dashboard: Settings -> API Keys -> CLOUDINARY_URL
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Admin Access Credentials
ADMIN_EMAIL=admin@vibeseekers.com
ADMIN_PASSWORD=Admin@1234

# Razorpay Payment Gateway (UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Delivery API (Resend or Brevo)
# Option A: Resend API (https://resend.com)
# For testing: from defaults to "Vibe Seekers <onboarding@resend.dev>"
# Once domain is verified: set EMAIL_FROM_ADDRESS=orders@yourdomain.com
RESEND_API_KEY=

# Option B: Brevo HTTP Email API (https://brevo.com)
BREVO_API_KEY=
EMAIL_FROM_NAME=Vibe Seekers
EMAIL_FROM_ADDRESS=

# Shiprocket Courier API Configuration (Optional)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
